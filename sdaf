class YogaGraphicalCanvas(QWidget):
    """
    An interactive vector canvas rendering a customized North Indian chart structure.
    Projects animated lines, curved swap vectors, and dynamic energy flow lines.
    Now elegantly unifying D1 and D9 visual layouts side-by-side.
    """
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setMinimumSize(400, 400)
        
        self.chart_data = None
        self.highlight_houses = []
        self.highlight_planets = []
        self.relation_type = ""
        self.is_hard = False
        self.is_cancelled = False  # NEW: Track Bhang status
        
        # Animation parameters
        self.pulse_factor = 0.0
        self.flow_offset = 0.0
        
        # Performance friendly timer for real-time vector animations
        self.anim_timer = QTimer(self)
        self.anim_timer.timeout.connect(self._update_animation_cycle)
        self.anim_timer.start(33)  # Target ~30 FPS

    def update_view(self, chart_data, active_houses, active_planets, relation_type, is_hard=False, is_cancelled=False):
        self.chart_data = chart_data
        self.highlight_houses = active_houses
        self.highlight_planets = active_planets
        self.relation_type = relation_type
        self.is_hard = is_hard
        self.is_cancelled = is_cancelled  # NEW: Store Bhang status
        self.update()

    def _update_animation_cycle(self):
        # Gracefully handle zero CPU constraints from parent app settings
        # try:
        #     import chart_renderer
        #     zero_cpu = getattr(chart_renderer, "ZERO_CPU_USAGE", False)
        # except Exception:
        #     zero_cpu = False
        zero_cpu = False
            
        if zero_cpu:
            if self.anim_timer.isActive():
                self.anim_timer.stop()
            self.pulse_factor = 0.0
            self.flow_offset = 0.0
            return
            
        if not self.anim_timer.isActive():
            self.anim_timer.start(33)
            
        self.pulse_factor = (self.pulse_factor + 0.06) % (2 * math.pi)
        self.flow_offset = (self.flow_offset + 0.02) % 1.0
        if self.isVisible() and self.chart_data:
            self.update()

    def paintEvent(self, event):
        if not self.chart_data or not self.chart_data.get("D1"):
            return
            
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)

        is_dark = self.palette().window().color().value() < 120
        grid_color = QColor(80, 80, 90) if is_dark else QColor(190, 190, 190)
        text_color = QColor(240, 240, 240) if is_dark else QColor(30, 30, 30)
        
        glowing_alpha = int(140 + 80 * math.sin(self.pulse_factor))
        
        # Visually segregate hard/afflicted alignments with striking dark crimson themes
        if self.is_hard:
            highlight_color = QColor(220, 20, 60, glowing_alpha)      # Crimson Red
            edge_glow_color = QColor(139, 0, 139, glowing_alpha)       # Deep Magenta/Violet
        else:
            highlight_color = QColor(255, 170, 0, glowing_alpha)      # Pure celestial Gold
            edge_glow_color = QColor(0, 170, 255, glowing_alpha)       # Electric Cyan

        has_d9 = self.chart_data.get("D9") is not None
        w_total, h_total = self.width(), self.height()
        
        # Calculate dynamic positions allowing lines to easily cross between D1 and D9
        if has_d9:
            size = min(w_total / 2.0 - 40, h_total - 40)
            d1_x = w_total / 4.0 - size / 2.0
            d9_x = 3 * w_total / 4.0 - size / 2.0
            cy = h_total / 2.0
            d1_y = cy - size / 2.0
            d9_y = cy - size / 2.0
        else:
            size = min(w_total, h_total) - 50
            d1_x = w_total / 2.0 - size / 2.0
            d1_y = h_total / 2.0 - size / 2.0
            d9_x, d9_y = 0, 0

        h_centers = {}

        def draw_grid(chart_key, x, y, size):
            painter.setBrush(Qt.BrushStyle.NoBrush)
            painter.setPen(QPen(grid_color, 1.5))
            painter.drawRect(int(x), int(y), int(size), int(size))
            
            painter.drawLine(int(x), int(y), int(x + size), int(y + size))
            painter.drawLine(int(x + size), int(y), int(x), int(y + size))
            
            painter.drawLine(int(x + size/2), int(y), int(x + size), int(y + size/2))
            painter.drawLine(int(x + size), int(y + size/2), int(x + size/2), int(y + size))
            painter.drawLine(int(x + size/2), int(y + size), int(x), int(y + size/2))
            painter.drawLine(int(x), int(y + size/2), int(x + size/2), int(y))

            h_centers[(chart_key, 1)] = QPointF(x + size/2, y + size/4)
            h_centers[(chart_key, 2)] = QPointF(x + size/4, y + size/8)
            h_centers[(chart_key, 3)] = QPointF(x + size/8, y + size/4)
            h_centers[(chart_key, 4)] = QPointF(x + size/4, y + size/2)
            h_centers[(chart_key, 5)] = QPointF(x + size/8, y + 3*size/4)
            h_centers[(chart_key, 6)] = QPointF(x + size/4, y + 7*size/8)
            h_centers[(chart_key, 7)] = QPointF(x + size/2, y + 3*size/4)
            h_centers[(chart_key, 8)] = QPointF(x + 3*size/4, y + 7*size/8)
            h_centers[(chart_key, 9)] = QPointF(x + 7*size/8, y + 3*size/4)
            h_centers[(chart_key, 10)] = QPointF(x + 3*size/4, y + size/2)
            h_centers[(chart_key, 11)] = QPointF(x + 7*size/8, y + size/4)
            h_centers[(chart_key, 12)] = QPointF(x + 3*size/4, y + size/8)
            
            painter.setFont(QFont("Arial", 10, QFont.Weight.Bold))
            painter.setPen(text_color)
            painter.drawText(int(x + size/2 - 10), int(y - 10), chart_key)
            
            planets_by_house = {i: [] for i in range(1, 13)}
            c_data = self.chart_data.get(chart_key, {})
            for p in c_data.get("planets", []):
                planets_by_house[p["house"]].append(p)
                
            asc_sign = c_data.get("ascendant", {}).get("sign_num", 1)
            
            for h_num in range(1, 13):
                pt = h_centers[(chart_key, h_num)]
                rashi_sign = ((asc_sign + h_num - 2) % 12) + 1
                h_planets = planets_by_house[h_num]
                count = len(h_planets)
                
                # Push Rashi numbers safely into the sharp corners of the diamonds/triangles
                if count > 0:
                    if h_num == 1: rx, ry = pt.x() - 5, pt.y() - size/4 + 18
                    elif h_num == 4: rx, ry = pt.x() - size/4 + 18, pt.y() + 4
                    elif h_num == 7: rx, ry = pt.x() - 5, pt.y() + size/4 - 10
                    elif h_num == 10: rx, ry = pt.x() + size/4 - 28, pt.y() + 4
                    elif h_num in [2, 5]: rx, ry = pt.x() - size/8 + 8, pt.y() - size/8 + 18
                    elif h_num in [3, 6]: rx, ry = pt.x() - size/8 + 8, pt.y() + size/8 - 8
                    elif h_num in [8, 11]: rx, ry = pt.x() + size/8 - 20, pt.y() + size/8 - 8
                    elif h_num in [9, 12]: rx, ry = pt.x() + size/8 - 20, pt.y() - size/8 + 18
                    else: rx, ry = pt.x() - 5, pt.y() - 15
                else:
                    rx, ry = pt.x() - 5, pt.y() - 15
                
                painter.setFont(QFont("Arial", 8))
                painter.setPen(QPen(grid_color))
                painter.drawText(int(rx), int(ry), str(rashi_sign))
                
                for idx, p_info in enumerate(h_planets):
                    p_name = p_info["name"]
                    p_offset_x, p_offset_y = 0, 12 * idx
                    if count > 1:
                        p_offset_y = (idx - (count - 1) / 2.0) * 14
                    
                    pt_draw = QPointF(pt.x() + p_offset_x, pt.y() + p_offset_y)
                    shorthand = p_name[:2]
                    
                    if p_name in self.highlight_planets:
                        painter.setFont(QFont("Arial", 9, QFont.Weight.Bold))
                        if self.is_hard:
                            painter.setPen(QPen(QColor(255, 50, 50) if is_dark else QColor(180, 0, 0)))
                            painter.setBrush(QBrush(QColor(220, 20, 60, 40)))
                        else:
                            painter.setPen(QPen(QColor(255, 140, 0) if is_dark else QColor(220, 100, 0)))
                            painter.setBrush(QBrush(QColor(255, 170, 0, 40)))
                        painter.drawRect(int(pt_draw.x() - 11), int(pt_draw.y() - 9), 22, 13)
                    else:
                        painter.setFont(QFont("Arial", 8))
                        painter.setPen(QPen(text_color))
                        
                    painter.drawText(int(pt_draw.x() - 9), int(pt_draw.y() + 2), shorthand)

        # Draw structural definitions before relational overlays
        draw_grid("D1", d1_x, d1_y, size)
        if has_d9:
            draw_grid("D9", d9_x, d9_y, size)

        # -----------------------------------------------------------------
        # ANIMATED RELATIONSHIP LAYERS
        # -----------------------------------------------------------------
        if len(self.highlight_houses) > 0:
            # Pulsing halos on active houses
            painter.setPen(Qt.PenStyle.NoPen)
            for hh in self.highlight_houses:
                pt = h_centers.get(hh)
                if pt:
                    # Hard yogas feature sharp alarm outlines inside the halo
                    if self.is_hard:
                        radial_brush = QColor(220, 20, 60, 25)
                        painter.setBrush(QBrush(radial_brush))
                        painter.drawEllipse(pt, size * 0.13, size * 0.13)
                        painter.setPen(QPen(QColor(220, 20, 60, 110), 1, Qt.PenStyle.DashLine))
                        painter.setBrush(Qt.BrushStyle.NoBrush)
                        painter.drawEllipse(pt, size * 0.10, size * 0.10)
                        painter.setPen(Qt.PenStyle.NoPen)
                    else:
                        radial_brush = QColor(highlight_color.red(), highlight_color.green(), highlight_color.blue(), 30)
                        painter.setBrush(QBrush(radial_brush))
                        painter.drawEllipse(pt, size * 0.12, size * 0.12)

                    # NEW: Render protective neutralizing shield for cancelled yogas
                    if self.is_cancelled:
                        cancel_color = QColor(50, 205, 50, glowing_alpha) # Vibrant green for safety/bhang
                        painter.setPen(QPen(cancel_color, 2, Qt.PenStyle.SolidLine))
                        painter.setBrush(Qt.BrushStyle.NoBrush)
                        # Draw a cross and a protective ring
                        painter.drawLine(int(pt.x() - 14), int(pt.y() - 14), int(pt.x() + 14), int(pt.y() + 14))
                        painter.drawLine(int(pt.x() - 14), int(pt.y() + 14), int(pt.x() + 14), int(pt.y() - 14))
                        painter.drawEllipse(pt, size * 0.14, size * 0.14)
                        painter.setPen(Qt.PenStyle.NoPen)

            # Group houses by chart to prevent visual lines from crossing the screen illegally
            d1_houses = [h for h in self.highlight_houses if h[0] == "D1"]
            d9_houses = [h for h in self.highlight_houses if h[0] == "D9"]
            
            # Cross-chart detection for Vargottamas 
            is_cross_chart = len(self.highlight_houses) == 2 and self.highlight_houses[0][0] != self.highlight_houses[1][0]
            
            if is_cross_chart:
                drawing_batches = [self.highlight_houses]
            else:
                drawing_batches = [d1_houses, d9_houses]

            for batch in drawing_batches:
                if not batch: continue

                # Draw dynamic geometric structures depending on Yoga classification
                if self.relation_type == "conjunction":
                    for hh in batch:
                        pt = h_centers.get(hh)
                        if pt:
                            painter.setPen(QPen(highlight_color, 2, Qt.PenStyle.DashLine))
                            painter.setBrush(Qt.BrushStyle.NoBrush)
                            painter.drawEllipse(pt, 30, 30)
                            
                            painter.setPen(Qt.PenStyle.NoPen)
                            # Pulsing center tag
                            pulsing_radius = 20 + 8 * math.sin(self.pulse_factor * 1.5)
                            painter.setBrush(QBrush(QColor(highlight_color.red(), highlight_color.green(), highlight_color.blue(), 50)))
                            painter.drawEllipse(pt, pulsing_radius, pulsing_radius)

                elif self.relation_type == "aspect":
                    if len(batch) >= 2:
                        pt1 = h_centers.get(batch[0])
                        pt2 = h_centers.get(batch[1])
                        
                        if pt1 and pt2:
                            dx, dy = pt2.x() - pt1.x(), pt2.y() - pt1.y()
                            length = math.hypot(dx, dy)
                            if length > 0:
                                px, py = -dy / length * 6, dx / length * 6
                                offset = QPointF(px, py)
                                
                                painter.setPen(QPen(edge_glow_color, 1.5, Qt.PenStyle.SolidLine))
                                painter.drawLine(pt1 + offset, pt2 + offset)
                                painter.setPen(QPen(highlight_color, 1.5, Qt.PenStyle.SolidLine))
                                painter.drawLine(pt1 - offset, pt2 - offset)
                                
                                t1 = self.flow_offset
                                t2 = (self.flow_offset + 0.5) % 1.0
                                pt_fwd = (pt1 + offset) + (pt2 - pt1) * t1
                                pt_bwd = (pt2 - offset) + (pt1 - pt2) * t2
                                
                                painter.setPen(Qt.PenStyle.NoPen)
                                painter.setBrush(QBrush(QColor(255, 255, 255)))
                                painter.drawEllipse(pt_fwd, 4.5, 4.5)
                                painter.drawEllipse(pt_bwd, 4.5, 4.5)

                elif self.relation_type == "exchange":
                    if len(batch) >= 2:
                        pt1 = h_centers.get(batch[0])
                        pt2 = h_centers.get(batch[1])
                        
                        if pt1 and pt2:
                            mid = (pt1 + pt2) / 2.0
                            dx, dy = pt2.x() - pt1.x(), pt2.y() - pt1.y()
                            length = math.hypot(dx, dy)
                            if length > 0:
                                # Draw two curved parabolic paths representing sign exchange (swap loop)
                                px, py = -dy / length * (size * 0.12), dx / length * (size * 0.12)
                                control1 = mid + QPointF(px, py)
                                control2 = mid - QPointF(px, py)
                                
                                painter.setBrush(Qt.BrushStyle.NoBrush)
                                
                                path1 = QPainterPath()
                                path1.moveTo(pt1)
                                path1.quadTo(control1, pt2)
                                painter.setPen(QPen(edge_glow_color, 2, Qt.PenStyle.SolidLine))
                                painter.drawPath(path1)
                                
                                path2 = QPainterPath()
                                path2.moveTo(pt2)
                                path2.quadTo(control2, pt1)
                                painter.setPen(QPen(highlight_color, 2, Qt.PenStyle.SolidLine))
                                painter.drawPath(path2)
                                
                                t = self.flow_offset
                                pos1 = (1 - t)**2 * pt1 + 2 * (1 - t) * t * control1 + t**2 * pt2
                                pos2 = (1 - t)**2 * pt2 + 2 * (1 - t) * t * control2 + t**2 * pt1
                                
                                painter.setPen(Qt.PenStyle.NoPen)
                                painter.setBrush(QBrush(QColor(255, 255, 255)))
                                
                                # Hard yogas feature sharp warning diamonds on swap paths
                                if self.is_hard:
                                    painter.setBrush(QBrush(QColor(255, 50, 50)))
                                    for pos in [pos1, pos2]:
                                        p_poly = QPolygonF([
                                            QPointF(pos.x(), pos.y() - 5),
                                            QPointF(pos.x() + 5, pos.y()),
                                            QPointF(pos.x(), pos.y() + 5),
                                            QPointF(pos.x() - 5, pos.y())
                                        ])
                                        painter.drawPolygon(p_poly)
                                else:
                                    painter.drawEllipse(pos1, 5, 5)
                                    painter.drawEllipse(pos2, 5, 5)

                elif self.relation_type == "kendra":
                    if len(batch) >= 2:
                        painter.setPen(QPen(edge_glow_color, 2, Qt.PenStyle.DashLine))
                        painter.setBrush(Qt.BrushStyle.NoBrush)
                        
                        path = QPainterPath()
                        pt_start = h_centers.get(batch[0])
                        if pt_start:
                            path.moveTo(pt_start)
                            chart_key = batch[0][0]
                            # Anchor locally to the exact chart to prevent crossing screens
                            local_cx = d1_x + size/2 if chart_key == "D1" else d9_x + size/2
                            local_cy = d1_y + size/2 if chart_key == "D1" else d9_y + size/2
                            
                            for idx in range(1, len(batch)):
                                pt_end = h_centers.get(batch[idx])
                                if pt_end:
                                    path.quadTo(QPointF(local_cx, local_cy), pt_end)
                            painter.drawPath(path)

                elif self.relation_type == "trine":
                    if len(batch) >= 3:
                        pts = [h_centers[hh] for hh in batch if hh in h_centers]
                        if len(pts) >= 3:
                            tri_poly = QPolygonF(pts)
                            painter.setPen(QPen(highlight_color, 2, Qt.PenStyle.SolidLine))
                            painter.setBrush(QBrush(QColor(highlight_color.red(), highlight_color.green(), highlight_color.blue(), 20)))
                            painter.drawPolygon(tri_poly)

                elif self.relation_type == "rajayoga":
                    for hh in batch:
                        pt = h_centers.get(hh)
                        if pt:
                            # Rotating royal crest framing conjoined Raja Yoga lords
                            painter.setBrush(QBrush(QColor(255, 215, 0, 45)))
                            painter.setPen(QPen(QColor(255, 215, 0, glowing_alpha), 2.5))
                            
                            star_poly = QPolygonF()
                            num_tips = 8
                            for i in range(num_tips * 2):
                                r = (size * 0.08) if i % 2 == 0 else (size * 0.035)
                                angle = self.pulse_factor + i * math.pi / num_tips
                                star_poly.append(QPointF(pt.x() + r * math.cos(angle), pt.y() + r * math.sin(angle)))
                            painter.drawPolygon(star_poly)

                elif self.relation_type == "neechabhanga":
                    # Emerald protection rings representing debilitation cancellation strength
                    for hh in batch:
                        pt = h_centers.get(hh)
                        if pt:
                            painter.setPen(QPen(QColor(50, 205, 50, glowing_alpha), 2, Qt.PenStyle.SolidLine))
                            painter.setBrush(QBrush(QColor(50, 205, 50, 25)))
                            
                            shield_path = QPainterPath()
                            shield_path.addEllipse(pt, 25 + 4 * math.sin(self.pulse_factor * 1.5), 25 + 4 * math.sin(self.pulse_factor * 1.5))
                            painter.drawPath(shield_path)

                elif self.relation_type == "vipreet":
                    # Mysterious, dense indigo protective shields protecting from negative dusthanas
                    for hh in batch:
                        pt = h_centers.get(hh)
                        if pt:
                            painter.setPen(QPen(QColor(75, 0, 130, glowing_alpha), 2, Qt.PenStyle.DashDotLine))
                            painter.setBrush(QBrush(QColor(75, 0, 130, 40)))
                            
                            shield_poly = QPolygonF()
                            sides = 6
                            for i in range(sides):
                                angle = i * (2 * math.pi / sides) + self.pulse_factor * 0.5
                                radius = 24 + 3 * math.sin(self.pulse_factor + i)
                                shield_poly.append(QPointF(pt.x() + radius * math.cos(angle), pt.y() + radius * math.sin(angle)))
                            painter.drawPolygon(shield_poly)

                elif self.relation_type == "special":
                    for hh in batch:
                        pt = h_centers.get(hh)
                        if pt:
                            painter.setPen(QPen(highlight_color, 1.5))
                            painter.setBrush(Qt.BrushStyle.NoBrush)
                            painter.drawEllipse(pt, 25 + 5 * math.sin(self.pulse_factor * 2), 25 + 5 * math.sin(self.pulse_factor * 2))
                            
                elif self.relation_type == "lord_in":
                    if len(batch) >= 2:
                        pt_occupied = h_centers.get(batch[0])  # House Y (Placed)
                        pt_ruled = h_centers.get(batch[1])     # House X (Rules)
                        
                        if pt_occupied and pt_ruled:
                            # Draw vector trail line linking ruled house to target house
                            painter.setPen(QPen(highlight_color, 2.5, Qt.PenStyle.SolidLine))
                            painter.drawLine(pt_ruled, pt_occupied)
                            
                            # Render animated directional energy pulses traveling along path
                            t = self.flow_offset
                            pt_pulse = pt_ruled + (pt_occupied - pt_ruled) * t
                            painter.setPen(Qt.PenStyle.NoPen)
                            painter.setBrush(QBrush(edge_glow_color))
                            painter.drawEllipse(pt_pulse, 6.0, 6.0)
                            
                            # Draw explicit vector arrowhead at the target occupied house
                            dx = pt_occupied.x() - pt_ruled.x()
                            dy = pt_occupied.y() - pt_ruled.y()
                            angle = math.atan2(dy, dx)
                            
                            # Inset arrow tip slightly from center to avoid text collisions
                            arrow_tip = pt_occupied - QPointF(math.cos(angle) * 16, math.sin(angle) * 16)
                            arrow_poly = QPolygonF([
                                arrow_tip,
                                arrow_tip - QPointF(math.cos(angle - math.pi/6) * 12, math.sin(angle - math.pi/6) * 12),
                                arrow_tip - QPointF(math.cos(angle + math.pi/6) * 12, math.sin(angle + math.pi/6) * 12)
                            ])
                            painter.setBrush(QBrush(highlight_color))
                            painter.drawPolygon(arrow_poly)
                elif self.relation_type.startswith("nabhasa"):
                    count = int(self.relation_type.split("_")[1])
                    
                    # Unique colors mapped to elemental concepts of the count
                    color_map = {
                        7: QColor(148, 0, 211, glowing_alpha),  # Ether (Violet)
                        6: QColor(0, 255, 255, glowing_alpha),  # Air (Cyan)
                        5: QColor(30, 144, 255, glowing_alpha), # Water (Deep Blue)
                        4: QColor(50, 205, 50, glowing_alpha),  # Earth (Emerald Green)
                        3: QColor(255, 69, 0, glowing_alpha),   # Fire (Bright Red-Orange)
                        2: QColor(255, 215, 0, glowing_alpha),  # Duality (Gold)
                        1: QColor(255, 255, 255, glowing_alpha) # Singularity (White)
                    }
                    nab_color = color_map.get(count, highlight_color)
                    
                    painter.setPen(QPen(nab_color, 2, Qt.PenStyle.DashDotLine))
                    painter.setBrush(QBrush(QColor(nab_color.red(), nab_color.green(), nab_color.blue(), 25)))
                    
                    if len(batch) > 1:
                        # 1. Draw a constellation polygon linking all occupied houses
                        pts = [h_centers[hh] for hh in batch if hh in h_centers]
                        constellation = QPolygonF(pts)
                        painter.drawPolygon(constellation)
                        
                        # 2. Draw vivid pulsing star nodes at every occupied house
                        painter.setPen(Qt.PenStyle.NoPen)
                        for pt in pts:
                            painter.setBrush(QBrush(nab_color))
                            star_poly = QPolygonF()
                            num_points = 8
                            for i in range(num_points * 2):
                                r = 14 if i % 2 == 0 else 6
                                angle = self.pulse_factor * 2 + i * math.pi / num_points
                                star_poly.append(QPointF(pt.x() + r * math.cos(angle), pt.y() + r * math.sin(angle)))
                            painter.drawPolygon(star_poly)
                            
                    elif len(batch) == 1:
                        # Gola Yoga (all 7 planets crushed into 1 single house) - Massive Singularity Halo
                        pt = h_centers.get(batch[0])
                        if pt:
                            painter.setPen(Qt.PenStyle.NoPen)
                            painter.setBrush(QBrush(nab_color))
                            radius = 45 + 15 * math.sin(self.pulse_factor * 3)
                            painter.drawEllipse(pt, radius, radius)

        painter.end()


