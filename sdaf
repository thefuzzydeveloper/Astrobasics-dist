            houses_list = [("D1", h) for h in occupied_houses]
            ev = _("All 7 classical planets occupy exactly {c} distinct signs.").format(c=count)
            results.append((houses_list, classical, rel_type, yoga_name, ev, False, ""))
            
    return results

