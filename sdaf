def check_dharma_karmadhipati_yoga(planets, d9_planets=None):
    results, hl = [], get_house_lords(planets)
    p9, p10 = planets.get(hl.get(9)), planets.get(hl.get(10))
    if p9 and p10 and p9["house"] == p10["house"] and hl.get(9) != hl.get(10):
        ev = _("The 9th lord ({l9}) and 10th lord ({l10}) are strictly conjoined in the {h} house.").format(l9=_(hl.get(9)), l10=_(hl.get(10)), h=p9["house"])
        results.append(([("D1", p9["house"])], [hl.get(9), hl.get(10)], "rajayoga", "Dharma-Karmadhipati Raja Yoga", ev, False, ""))
    return results

def check_standard_raja_yoga(planets, d9_planets=None):
    results, hl = [], get_house_lords(planets)
    for k in [1, 4, 7, 10]:
        for t in [1, 5, 9]:
            if {k, t} == {9, 10} or hl.get(k) == hl.get(t): continue
            pk, pt = planets.get(hl.get(k)), planets.get(hl.get(t))
            if pk and pt and pk["house"] == pt["house"]:
                ev = _("The {k}th Kendra lord ({lk}) and {t}th Trikona lord ({lt}) are conjoined in the {h} house.").format(k=k, lk=_(hl.get(k)), t=t, lt=_(hl.get(t)), h=pk["house"])
                results.append(([("D1", pk["house"])], [hl.get(k), hl.get(t)], "rajayoga", f"Standard Raja Yoga ({k}H + {t}H)", ev, False, ""))
    return results

def check_dharma_karma_aspect(planets, d9_planets=None):
    results, hl = [], get_house_lords(planets)
    p9, p10 = planets.get(hl.get(9)), planets.get(hl.get(10))
    if p9 and p10 and hl.get(9) != hl.get(10):
        if p10["house"] in get_aspected_houses(hl.get(9), p9["house"]) and p9["house"] in get_aspected_houses(hl.get(10), p10["house"]):
            ev = _("The 9th lord ({l9}) and 10th lord ({l10}) mutually aspect each other.").format(l9=_(hl.get(9)), l10=_(hl.get(10)))
            results.append(([("D1", p9["house"]), ("D1", p10["house"])], [hl.get(9), hl.get(10)], "aspect", "Dharma-Karma Aspect", ev, False, ""))
    return results

def check_exchange_aspect_raja_yoga(planets, d9_planets=None):
    results, hl = [], get_house_lords(planets)
    exchanges = {(a, b) for a, b, _, _ in check_parivartana(planets)}
    for k in [1, 4, 7, 10]:
        for t in [1, 5, 9]:
            if {k, t} == {9, 10} or hl.get(k) == hl.get(t): continue
            pk, pt = planets.get(hl.get(k)), planets.get(hl.get(t))
            if pk and pt:
                is_asp = pt["house"] in get_aspected_houses(hl.get(k), pk["house"]) and pk["house"] in get_aspected_houses(hl.get(t), pt["house"])
                is_exch = (k, t) in exchanges or (t, k) in exchanges
                if is_asp or is_exch:
                    rel = "exchange" if is_exch else "aspect"
                    ev = _("The {k}th Kendra lord ({lk}) and {t}th Trikona lord ({lt}) strongly {mode} each other.").format(k=k, lk=_(hl.get(k)), t=t, lt=_(hl.get(t)), mode="exchange signs with" if is_exch else "aspect")
                    results.append(([("D1", pk["house"]), ("D1", pt["house"])], [hl.get(k), hl.get(t)], rel, f"Exchange/Aspect Raja Yoga", ev, False, ""))
    return results

