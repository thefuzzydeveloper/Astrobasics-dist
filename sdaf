def setup_ui(main_app, layout):
    """Hooks launcher controls elegantly into the host application."""
    group = QGroupBox(_("Graphical Yoga System"))
    vbox = QVBoxLayout()
    
    btn_open_window = QPushButton(_("Launch Yoga Visualizer"))
    btn_open_window.setObjectName("btnAction")
    
    vbox.addWidget(btn_open_window)
    group.setLayout(vbox)
    layout.addWidget(group)

    def trigger_visual_explorer():
        main_app.graphical_yoga_window = GraphicalYogaWindow(main_app)
        # Force the plugin dialog to instantly launch maximized/fullscreen
        main_app.graphical_yoga_window.showMaximized()
        main_app.graphical_yoga_window.raise_()
        main_app.graphical_yoga_window.activateWindow()

    btn_open_window.clicked.connect(trigger_visual_explorer)


