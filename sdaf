class GraphicalYogaWindow(QDialog):
    """
    Dialog displaying the interactive side-by-side yoga scanning system.
    Launches Maximized to provide complete distraction-free visual workspace.
    Detached from parent's window tree to function fully modelessly.
    """
    def __init__(self, main_app, parent=None):
        # Pass None as parent to detach the window from the main application's window group
        super().__init__(None)
        self.main_app = main_app
        self.setWindowTitle(_("Vedic Yoga Visualizer"))
        
        # Configure standalone window capabilities
        self.setWindowFlags(Qt.WindowType.Window | Qt.WindowType.WindowMinMaxButtonsHint | Qt.WindowType.WindowCloseButtonHint)
        
        main_layout = QHBoxLayout(self)
        main_layout.setContentsMargins(15, 15, 15, 15)
        
        splitter = QSplitter(Qt.Orientation.Horizontal, self)
        main_layout.addWidget(splitter)
        
        left_widget = QWidget()
        left_layout = QVBoxLayout(left_widget)
        left_layout.setContentsMargins(0, 0, 0, 0)
        
        info_title = QLabel(_("Detected Auspicious Yogas"))
        info_title.setStyleSheet("font-weight: bold; font-size: 14px;")
        left_layout.addWidget(info_title)
        
        self.yoga_list = QListWidget()
        self.yoga_list.setSelectionMode(QListWidget.SelectionMode.SingleSelection)
        self.yoga_list.setStyleSheet("font-size: 12px; padding: 5px;")
        left_layout.addWidget(self.yoga_list)
        
        # Replace the single desc_group with this split layout:
        self.evidence_group = QGroupBox(_("Astrological Evidence"))
        self.evidence_group.setStyleSheet("font-weight: bold; font-size: 11px;")
        ev_layout = QVBoxLayout(self.evidence_group)
        self.evidence_label = QLabel(_("Select a detected yoga to view its exact planetary alignments."))
        self.evidence_label.setWordWrap(True)
        self.evidence_label.setStyleSheet("color: #0078D7; font-weight: bold; font-size: 12px;") # Emphasize evidence
        ev_layout.addWidget(self.evidence_label)
        left_layout.addWidget(self.evidence_group)

        self.result_group = QGroupBox(_("Predicted Result"))
        self.result_group.setStyleSheet("font-weight: bold; font-size: 11px;")
        res_layout = QVBoxLayout(self.result_group)
        self.result_label = QLabel(_("Effects will be displayed here."))
        self.result_label.setWordWrap(True)
        self.result_label.setStyleSheet("color: gray; font-weight: normal; font-size: 12px;")
        res_layout.addWidget(self.result_label)
        left_layout.addWidget(self.result_group)
        
        splitter.addWidget(left_widget)
        
        self.canvas = YogaGraphicalCanvas()
        splitter.addWidget(self.canvas)
        
        splitter.setStretchFactor(0, 3)
        splitter.setStretchFactor(1, 5)
        
        self.yoga_list.itemSelectionChanged.connect(self.on_yoga_selected)
        
        self.detected_yogas = {}
        self.chart_data = None
        
        self.run_astrological_scan()

    def run_astrological_scan(self):
        
        self.yoga_list.clear()
        self.detected_yogas.clear()
        
        renderers = getattr(self.main_app, 'renderers', {})
        d1_renderer = renderers.get("D1")
        if not d1_renderer:
            d1_renderer = list(renderers.values())[0] if renderers else None
            
        d9_renderer = renderers.get("D9")

        if not d1_renderer or not d1_renderer.chart_data:
            self.yoga_list.addItem(_("No active chart data found."))
            return

        self.chart_data = {
            "D1": copy.deepcopy(d1_renderer.chart_data),
            "D9": copy.deepcopy(d9_renderer.chart_data) if d9_renderer and hasattr(d9_renderer, 'chart_data') else None
        }
        
        normalized_d1 = get_normalized_planets(self.chart_data["D1"])
        normalized_d9 = get_normalized_planets(self.chart_data["D9"]) if self.chart_data["D9"] else None
        
        grouped_matches = {cat: [] for cat in YOGA_CATEGORIES}
        grouped_matches["Other Yogas"] = []

        for y_name, spec in YOGA_REGISTRY.items():
            check_func = spec["check"]
            result = check_func(normalized_d1, normalized_d9)
            
            d1_matches = []
            if isinstance(result, tuple) and len(result) >= 4 and isinstance(result[0], bool):
                if result[0]: d1_matches.append(result[1:])
            elif isinstance(result, list):
                d1_matches = result
                
            d9_matches = []
            if normalized_d9:
                d9_raw = check_func(normalized_d9, None)
                if isinstance(d9_raw, tuple) and len(d9_raw) >= 4 and isinstance(d9_raw[0], bool):
                    if d9_raw[0]: d9_matches.append(d9_raw[1:])
                elif isinstance(d9_raw, list):
                    d9_matches = d9_raw

            for match in d1_matches:
                hl_houses = list(match[0])
                hl_planets = match[1]
                relation = match[2]
                custom_name = match[3] if len(match) > 3 else None
                exact_evidence = match[4] if len(match) > 4 else None
                
                is_cancelled = match[5] if len(match) > 5 else False
                bhang_ev = match[6] if len(match) > 6 else ""
                
                unique_name = custom_name if custom_name else (f"{y_name} ({', '.join(hl_planets)})" if len(d1_matches) > 1 else y_name)
                
                for d9_match in d9_matches:
                    d9_planets_list = d9_match[1]
                    d9_custom = d9_match[3] if len(d9_match) > 3 else None
                    
                    is_match = (set(hl_planets) == set(d9_planets_list))
                    if custom_name and d9_custom and custom_name != d9_custom:
                        is_match = False
                        
                    if is_match:
                        for h_tuple in d9_match[0]:
                            if h_tuple[0] == "D1":
                                hl_houses.append(("D9", h_tuple[1]))
                            else:
                                hl_houses.append(h_tuple)
                        break

                target_cat = "Other Yogas"
                for cat, items in YOGA_CATEGORIES.items():
                    if y_name == cat or any(item in unique_name or unique_name.startswith(item) for item in items):
                        target_cat = cat
                        break
                
                # Enforce that ALL "is_hard" items route exclusively to the hardships group
                is_hard_yoga = spec.get("is_hard", False) or target_cat == "Arishta & Hardship Yogas"
                if is_hard_yoga:
                    target_cat = "Arishta & Hardship Yogas"
                
                match_data = {
                    "unique_name": unique_name,
                    "houses": hl_houses,
                    "planets": hl_planets,
                    "relation": relation,
                    "desc": spec["desc"],
                    "exact_evidence": exact_evidence,
                    "is_hard": is_hard_yoga,
                    "is_cancelled": is_cancelled, # NEW
                    "bhang_evidence": bhang_ev    # NEW
                }
                grouped_matches[target_cat].append(match_data)

        from PyQt6.QtWidgets import QListWidgetItem
        from PyQt6.QtGui import QColor, QFont
        
        is_dark = chart_renderer.GLOBAL_DARK_MODE
        
        # FIX: Explicitly style the QListWidget background canvas to prevent system color leaks
        if is_dark:
            self.yoga_list.setStyleSheet(
                "font-size: 12px; padding: 5px; background-color: #1e1e1e; "
                "color: #e1e1e1; border: 1px solid #3a3a3a; outline: none;"
            )
        else:
            self.yoga_list.setStyleSheet(
                "font-size: 12px; padding: 5px; background-color: #ffffff; "
                "color: #232323; border: 1px solid #cccccc; outline: none;"
            )
        theme = DARK_THEME_PALETTE if is_dark else LIGHT_THEME_PALETTE
        group_colors = theme["categories"]
        hard_item_color = theme["hard_item"]
        standard_item_color = theme["standard_item"]

        total_added = 0
        for cat, matches in grouped_matches.items():
            if not matches:
                continue
            
            header_item = QListWidgetItem(f" [{_(cat).upper()}]")
            header_item.setFlags(header_item.flags() & ~Qt.ItemFlag.ItemIsSelectable)
            font_h = QFont()
            font_h.setBold(True)
            font_h.setPointSize(10)
            header_item.setFont(font_h)
            
            active_group_color = group_colors.get(cat, standard_item_color)
            header_item.setForeground(active_group_color)
            self.yoga_list.addItem(header_item)
            
            for m in matches:
                u_name = m["unique_name"]
                if u_name in self.detected_yogas:
                    continue
                    
                self.detected_yogas[u_name] = m
                
                # NEW: Modify the display name and styling if cancelled
                display_name = f"   • {u_name} [CANCELLED]" if m.get("is_cancelled") else f"   • {u_name}"
                child_item = QListWidgetItem(display_name)
                
                if m.get("is_cancelled"):
                    child_item.setForeground(QColor(130, 130, 130)) # Grayed out text
                    font_c = QFont()
                    font_c.setStrikeOut(True)
                    child_item.setFont(font_c)
                else:
                    child_item.setForeground(hard_item_color if m["is_hard"] else active_group_color)
                    if m["is_hard"]:
                        font_c = QFont()
                        font_c.setWeight(QFont.Weight.Medium)
                        child_item.setFont(font_c)
                    
                self.yoga_list.addItem(child_item)
                total_added += 1

        if total_added == 0:
            self.yoga_list.addItem(_("No major Yogas detected."))
        else:
            for i in range(self.yoga_list.count()):
                if self.yoga_list.item(i).flags() & Qt.ItemFlag.ItemIsSelectable:
                    self.yoga_list.setCurrentRow(i)
                    break

    def on_yoga_selected(self):
        items = self.yoga_list.selectedItems()
        if not items:
            return
            
        # Clean up tags used in the visual list string
        y_name = items[0].text().replace("•", "").replace("[CANCELLED]", "").strip()
        if y_name in self.detected_yogas:
            data = self.detected_yogas[y_name]
            
            desc_text = data["desc"]
            exact_ev = data.get("exact_evidence")
            
            # NEW: Grab Bhang variables
            is_cancelled = data.get("is_cancelled", False)
            bhang_ev = data.get("bhang_evidence", "")
            
            if "Result:" in desc_text:
                fallback_ev, res_text = desc_text.split("Result:", 1)
                fallback_ev = fallback_ev.replace("Evidence:", "").strip()
                final_evidence = exact_ev if exact_ev else fallback_ev
                
                if is_cancelled and bhang_ev:
                    final_evidence += f"\n\nNeutralized (Bhang): {bhang_ev}"
                
                self.evidence_label.setText(final_evidence)
                self.result_label.setText(f"[CANCELLED] {res_text.strip()}" if is_cancelled else res_text.strip())
            else:
                final_evidence = exact_ev if exact_ev else desc_text
                if is_cancelled and bhang_ev:
                    final_evidence += f"\n\nNeutralized (Bhang): {bhang_ev}"
                
                self.evidence_label.setText(final_evidence)
                self.result_label.setText("-")
            
            if data["is_hard"]:
                if is_cancelled:
                    # Hard yoga was cancelled: Show safe green UI
                    self.result_group.setStyleSheet("font-weight: bold; font-size: 11px; color: #32CD32;")
                    self.result_label.setStyleSheet("font-weight: normal; font-size: 12px; color: #32CD32;")
                else:
                    self.result_group.setStyleSheet("font-weight: bold; font-size: 11px; color: crimson;")
                    self.result_label.setStyleSheet("font-weight: normal; font-size: 12px; color: crimson;")
            else:
                self.result_group.setStyleSheet("font-weight: bold; font-size: 11px;")
                self.result_label.setStyleSheet("font-weight: normal; font-size: 12px; color: palette(text);")
                
            self.canvas.update_view(
                self.chart_data,
                data["houses"],
                data["planets"],
                data["relation"],
                is_hard=data["is_hard"],
                is_cancelled=is_cancelled  # NEW
            )


