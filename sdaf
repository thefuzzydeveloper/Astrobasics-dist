def get_normalized_planets(chart_data):
    """
    Normalizes planetary data from chart_data dictionary to ensure uniform structure.
    Resolves variations in coordinate system data for robust yoga condition scanning.
    """
    normalized = {}
    if not chart_data:
        return normalized
        
    planets_list = chart_data.get("planets", [])
    asc = chart_data.get("ascendant", {})
    
    # Process regular bodies
    for p in planets_list:
        name = p.get("name")
        normalized[name] = {
            "name": name,
            "house": p.get("house", 1),
            "sign_num": p.get("sign_num", p.get("sign_index", 0) + 1),
            "exalted": p.get("exalted", False),
            "debilitated": p.get("debilitated", False),
            "own_sign": p.get("own_sign", False),
            "retro": p.get("retro", False),
            "combust": p.get("combust", False),
        }
        
    # Append Ascendant as a virtual point for house/ruler checks
    if asc:
        normalized["Ascendant"] = {
            "name": "Ascendant",
            "house": 1,
            "sign_num": asc.get("sign_num", asc.get("sign_index", 0) + 1),
            "exalted": False,
            "debilitated": False,
            "own_sign": False,
            "retro": False,
            "combust": False
        }
    return normalized


def get_house_lords(planets):
    """Calculates the 1-indexed lord for each house from 1 to 12 based on the Ascendant's sign."""
    asc = planets.get("Ascendant")
    if not asc:
        return {}
    asc_sign = asc["sign_num"] # 1 to 12
    
    house_lords = {}
    for h in range(1, 13):
        sign_num = (asc_sign + h - 2) % 12 + 1
        house_lords[h] = SIGN_RULERS.get(sign_num)
    return house_lords


def get_aspected_houses(planet_name, from_house):
    """Calculates all houses aspected by a planet from its current house position."""
    aspects = [7] # Every planet aspects the 7th house
    if planet_name == "Mars":
        aspects.extend([4, 8])
    elif planet_name == "Jupiter":
        aspects.extend([5, 9])
    elif planet_name == "Saturn":
        aspects.extend([3, 10])
        
    aspected = []
    for asp in aspects:
        target = (from_house + asp - 1) % 12
        aspected.append(12 if target == 0 else target)
    return aspected


def get_debilitated_planets(planets):
    """Gathers all standard planets currently occupying their debilitation sign."""
    deb_planets = []
    for name, p in planets.items():
        if name in ["Rahu", "Ketu", "Ascendant"]:
            continue
        deb_sign = DEBILITATION_RULES.get(name)
        if deb_sign and p["sign_num"] == deb_sign:
            deb_planets.append(p)
    return deb_planets

