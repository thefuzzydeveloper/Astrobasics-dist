# --- 2. Parivartana (Exchange) Yogas ---

def check_parivartana(planets):
    exchanges = []
    p_names = [name for name in planets.keys() if name not in ["Rahu", "Ketu", "Ascendant"]]
    for i in range(len(p_names)):
        for j in range(i + 1, len(p_names)):
            p1, p2 = p_names[i], p_names[j]
            p1_data, p2_data = planets[p1], planets[p2]
            if SIGN_RULERS.get(p1_data["sign_num"]) == p2 and SIGN_RULERS.get(p2_data["sign_num"]) == p1:
                a, b = p1_data["house"], p2_data["house"]
                if a > b:
                    a, b = b, a
                    la, lb = p2, p1
                else:
                    la, lb = p1, p2
                exchanges.append((a, b, la, lb))
    return list(set(exchanges))

def check_dainya_yoga(planets, d9_planets=None):
    dusthanas, results = {6, 8, 12}, []
    for a, b, la, lb in check_parivartana(planets):
        if (a in dusthanas) ^ (b in dusthanas):
            dh = a if a in dusthanas else b
            nd = b if a in dusthanas else a
            ev = _("The {dh}th dusthana lord ({ld}) exchanged signs with the {nd}th lord ({lnd}).").format(dh=dh, ld=_(la if a in dusthanas else lb), nd=nd, lnd=_(lb if a in dusthanas else la))
            results.append(([("D1", a), ("D1", b)], [la, lb], "exchange", "Dainya Parivartana", ev, False, ""))
    return results

def check_khala_yoga(planets, d9_planets=None):
    dusthanas, results = {6, 8, 12}, []
    for a, b, la, lb in check_parivartana(planets):
        if (a == 3 or b == 3) and not (a in dusthanas or b in dusthanas):
            ev = _("The 3rd lord ({la}) exchanged its sign with the {nd}th lord ({lb}).").format(la=_(la if a==3 else lb), nd=b if a==3 else a, lb=_(lb if a==3 else la))
            results.append(([("D1", a), ("D1", b)], [la, lb], "exchange", "Khala Parivartana", ev, False, ""))
    return results

