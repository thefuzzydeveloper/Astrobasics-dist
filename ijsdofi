def check_gajakesari(planets, d9_planets=None):
    results = []
    ju, mo = planets.get("Jupiter"), planets.get("Moon")
    if ju and mo:
        diff = (ju["house"] - mo["house"]) % 12
        if diff in [0, 3, 6, 9]:
            rel = "conjunction" if diff == 0 else ("aspect" if diff == 6 else "kendra")
            ev = _("Jupiter is in the {j} house, which forms a Kendra from the Moon in the {m} house.").format(j=ju["house"], m=mo["house"])
            
            # Classical Benefic Yoga Bhanga Check
            is_cancelled = False
            bhang_ev = ""
            
            if ju["combust"]:
                is_cancelled = True
                bhang_ev = _("Yoga Bhanga: Jupiter is combust by the Sun, scorching its divine benevolence.")
            elif ju["debilitated"] or mo["debilitated"]:
                is_cancelled = True
                bhang_ev = _("Yoga Bhanga: One of the primary participating luminaries occupies its debilitation sign.")
            elif ju["house"] in [6, 8, 12] and mo["house"] in [6, 8, 12]:
                is_cancelled = True
                bhang_ev = _("Yoga Bhanga: The configuration is heavily obscured within adverse Dusthana houses.")
            elif d9_planets:
                ju9, mo9 = d9_planets.get("Jupiter"), d9_planets.get("Moon")
                if (ju9 and ju9["debilitated"]) or (mo9 and mo9["debilitated"]):
                    is_cancelled = True
                    bhang_ev = _("Yoga Bhanga: Root decay detected; participating planets are debilitated in the D9 Navamsha.")
                    
            results.append(([("D1", ju["house"]), ("D1", mo["house"])], ["Jupiter", "Moon"], rel, "Gajakesari Yoga", ev, is_cancelled, bhang_ev))
    return results

```

